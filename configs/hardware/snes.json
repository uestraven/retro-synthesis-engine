  "percussion": {
    "sampled": true,
    "voices": "shared",
    "default_instruments": [
      "kick",
      "snare",
      "hat",
      "tom",
      "cymbal"
    ]
  },
  "audio_ram": {
    "total_bytes": 65536,
    "brr_block_bytes": 9,
    "brr_samples_per_block": 16,
    "sample_directory_entry_bytes": 4,
    "echo_buffer_bytes_per_16ms": 2048,
    "notes": [
      "The echo buffer is charged against the same 64 KiB as the",
      "samples, the driver and the sequence, so a long reverb costs",
      "instrument memory. That tradeoff is the real hardware limit."
    ]
  },
  "output": {
    "nominal_sample_rate_hz": 32000,
    "channels": 2,
    "notes": [
      "32 kHz is the DSP's nominal output rate. It is NOT the rate a",
      "sample asset must be recorded at."
    ]
  },
