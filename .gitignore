__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Source datasets and derived training data are never committed (proposal 9).
/datasets/*
!/datasets/.gitkeep

# Written by scripts/make_sample_release.py, not authored.
/configs/datasets/rse_sample.json

# Model weights stay local -- anywhere, not just in checkpoints/. Four 21 MB
# checkpoints reached git history through tmp/, and two more sit in the
# repository root; a path-scoped rule did not stop either.
*.pt
*.pth
*.safetensors
*.ckpt
/checkpoints/*
!/checkpoints/.gitkeep

# Rendered output. No audio is ever committed: a listening batch is hundreds
# of megabytes, it is reproducible from its seed, and it is derived from
# research-only source material.
*.wav
*.ogg
*.mid
*.midi
*.mp3
*.flac
/out/

# Window caches: large, derived from research-only data, and rebuildable
# with `rse windows`. Never publish these.
caches/
/songs/*.wav

# Songs the API generates at runtime. Temporary by design -- the retention
# sweep deletes them -- and never part of the repository.
var/

# Generated songs, from either front end. The RATINGS.md and *_KEY.json files
# beside them ARE kept: the ratings are the research record, the audio is not.
/songs/
/listen_*/*.wav
/listen_*/**/*.wav
/codec_audio/
/transfer_audio/
/fermata_nes_audio/
/fermata_nes_audio_v2/
/gridtest/

# Scratch directories. `tmp/` held four 21 MB checkpoints and a .DS_Store for
# most of this project's history -- 86 MB of the repository, committed by
# accident. The checkpoints remain in git history, so nothing is lost.
tmp/
*.tar.gz
.DS_Store

# Analysis artifacts derived from NES-MDB. Regenerable by the scripts that
# wrote them, and never publishable: they carry per-window labels keyed to
# specific commercial games.
/repetition_train.json
/melodic_features.json
/conditioning_labels.jsonl
/window_motif_labels.jsonl
/fermata_representation_audit.json
/restatement_reference.json

# Frontend dependencies.
node_modules/
frontend/dist/
.vite/

# Build and run logs.
*.log

# Experiment scratch. Every script writes its report to the repository root or
# to a listen_*/ directory, and for most of this project's life those were
# left where they landed: 90 top-level entries of logs, token dumps, blinding
# keys and one-off JSON. All of it is regenerable by the script that wrote it.
#
# The ratings are NOT scratch and are kept in research/: those are the
# listener's own judgements and cannot be regenerated at all.
/listen_*/
/*_audit/
/audit_source_vs_nes/
/fermata_generations/
/fermata_nes_audio*/
/gridtest/
/transfer_audio/
/refrender/
/reference_pieces/
/codec_audio/
/out/
/*_KEY.json
/*_manifest.json
/sweep.csv

# One-off experiment reports written to the root by scripts/.
/architecture_comparison.json
/codec_comparison_*.json
/conditioning_gate2.json
/context_policy_*.json
/corrected_baseline.json
/fermata_nes_results*.json
/fermata_selection.json
/fermata_representation_audit.json
/gate2_*.json
/lead_continuity_*.json
/listening_batch2.json
/motif_thresholds_frozen.json
/paired_*.json
/procedural_batch.json
/profile_ab.json
/rhythm_ab.json
/rhythm_reference.json
/source_vs_arrangement.json
/structural_audit.json
/tempo_coverage.json
/tempo_precision_train.json
/theme_bank*.json
/theme_guided.json
/timing_fix_report.json
/transfer_audit_train*.json
/vocabulary_ab.json
/window_motif_report.json
